  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022  Le jour, la r\xE9sidence est calme : vis ta vie d'\xE9tudiant
    et \xE9coute les rumeurs.\n\n\u2022  De 22 h \xE0 6 h, les surveillants patrouillent
    dans les couloirs. Ne te fais pas voir.\n\n\u2022  Chaque niveau sous la r\xE9sidence
    est plus sombre, plus abandonn\xE9 et plus dangereux que le pr\xE9c\xE9dent.\n\n\u2022 
    Certains passages ne s'ouvrent qu'une fois le travail termin\xE9 \xE0 l'\xE9tage.\n\n\u2022 
    Ce qui vit en bas sait imiter. M\xE9fie-toi de ce qui te ressemble."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
