  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Le jour</b> : va en cours, fais tes t\xE2ches, parle aux autres \xE9tudiants.\n<b>La
    nuit</b> : faufile-toi vers les \xE9tages inf\xE9rieurs sans croiser les surveillants.\n\n\u2022 
    En bas, la lumi\xE8re se fait rare : garde ta lampe torche \xE0 port\xE9e de
    main.\n\n\u2022  Les passages bas, les trous et les conduits se franchissent
    accroupi.\n\n\u2022  Fouille partout : tous les chemins ne sont pas \xE0 la vue
    de tous.\n\n\u2022  Si une voix famili\xE8re t'appelle depuis l'obscurit\xE9\u2026
    ce n'est peut-\xEAtre pas elle."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
